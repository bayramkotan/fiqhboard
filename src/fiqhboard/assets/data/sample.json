 "evidence": [
  {
   "id": "quran:5:6",
   "kind": "quran",
   "ref": {
    "en": "Qur'an, al-Ma'ida 5:6",
    "tr": "Kur'ân, Mâide 5:6",
    "ar": "المائدة ٥: ٦"
   },
   "ar": "يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا قُمْتُمْ إِلَى الصَّلَاةِ فَاغْسِلُوا وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى الْمَرَافِقِ وَامْسَحُوا بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى الْكَعْبَيْنِ",
   "text": {
    "en": "O you who believe, when you rise to pray, wash your faces and your hands up to the elbows, wipe over your heads, and wash your feet up to the ankles.",
    "tr": "Ey iman edenler! Namaza kalktığınızda yüzlerinizi ve dirseklere kadar ellerinizi yıkayın, başlarınızı meshedin ve topuklara kadar ayaklarınızı yıkayın."
   }
  },
  {
   "id": "quran:4:43",
   "kind": "quran",
   "ref": {
    "en": "Qur'an, al-Nisa' 4:43",
    "tr": "Kur'ân, Nisâ 4:43",
    "ar": "النساء ٤: ٤٣"
   },
   "ar": "أَوْ لَامَسْتُمُ النِّسَاءَ فَلَمْ تَجِدُوا مَاءً فَتَيَمَّمُوا صَعِيدًا طَيِّبًا",
   "text": {
    "en": "…or you have touched women and find no water, then seek clean earth.",
    "tr": "…yahut kadınlara dokunmuşsanız ve su bulamamışsanız, temiz bir toprakla teyemmüm edin."
   }
  },
  {
   "id": "bukhari:1",
   "kind": "hadith",
   "ref": {
    "en": "al-Bukhari 1",
    "tr": "Buhârî, 1",
    "ar": "صحيح البخاري ١"
   },
   "ar": "إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى",
   "text": {
    "en": "Actions are only by intentions, and every person has only what he intended.",
    "tr": "Ameller ancak niyetlere göredir; herkese ancak niyet ettiği vardır."
   }
  },
  {
   "id": "muslim:360",
   "kind": "hadith",
   "ref": {
    "en": "Muslim 360",
    "tr": "Müslim, 360",
    "ar": "صحيح مسلم ٣٦٠"
   },
   "ar": "أَأَتَوَضَّأُ مِنْ لُحُومِ الْإِبِلِ؟ قَالَ: نَعَمْ، فَتَوَضَّأْ مِنْ لُحُومِ الْإِبِلِ",
   "text": {
    "en": "\"Shall I perform wudu after eating camel meat?\" He said: \"Yes, perform wudu after camel meat.\"",
    "tr": "\"Deve etinden dolayı abdest alayım mı?\" Buyurdu ki: \"Evet, deve etinden dolayı abdest al.\""
   }
  },
  {
   "id": "abudawud:181",
   "kind": "hadith",
   "ref": {
    "en": "Abu Dawud 181 (Busra bint Safwan)",
    "tr": "Ebû Dâvûd, 181 (Büsre bt. Safvân)",
    "ar": "سنن أبي داود ١٨١ (بسرة بنت صفوان)"
   },
   "ar": "مَنْ مَسَّ ذَكَرَهُ فَلْيَتَوَضَّأْ",
   "text": {
    "en": "Whoever touches his private part, let him perform wudu.",
    "tr": "Kim tenasül uzvuna dokunursa abdest alsın."
   }
  },
  {
   "id": "abudawud:182",
   "kind": "hadith",
   "ref": {
    "en": "Abu Dawud 182 (Talq ibn 'Ali)",
    "tr": "Ebû Dâvûd, 182 (Talk b. Ali)",
    "ar": "سنن أبي داود ١٨٢ (طلق بن علي)"
   },
   "ar": "هَلْ هُوَ إِلَّا مُضْغَةٌ مِنْهُ، أَوْ بَضْعَةٌ مِنْهُ",
   "text": {
    "en": "Is it anything but a piece of him?",
    "tr": "O, onun bir parçasından başka nedir ki?"
   }
  }
 ],
 "glossary": [
  {
   "id": "fard",
   "latin": "farḍ",
   "ar": "فرض",
   "def": {
    "en": "An act whose omission makes the act it belongs to invalid, or whose omission is sinful. The Hanafis reserve farḍ for what is proven by decisive evidence; the other three schools use farḍ and wājib as one.",
    "tr": "Terk edilmesi, ait olduğu ibadeti geçersiz kılan ya da terki günah olan fiil. Hanefîler farzı kesin delille sabit olana ayırır; diğer üç mezhep farz ile vâcibi aynı anlamda kullanır.",
    "ar": "ما يبطل العمل بتركه أو يأثم تاركه. خصّه الحنفية بما ثبت بدليل قطعي، والجمهور على أن الفرض والواجب بمعنى واحد."
   }
  },
  {
   "id": "wajib",
   "latin": "wājib",
   "ar": "واجب",
   "def": {
    "en": "For the Hanafis, a duty proven by evidence that is not decisive, between farḍ and sunna. For the Malikis, Shafi'is and Hanbalis, the same as farḍ. The word is never mapped from one school to another.",
    "tr": "Hanefîlerde kesin olmayan delille sabit, farz ile sünnet arasındaki yükümlülük. Mâlikî, Şâfiî ve Hanbelîlerde farzla aynı. Kelime bir mezhepten diğerine aktarılmaz.",
    "ar": "عند الحنفية: ما ثبت بدليل ظني، وهو بين الفرض والسنة. وعند المالكية والشافعية والحنابلة: مرادف للفرض."
   }
  },
  {
   "id": "sunna",
   "latin": "sunna",
   "ar": "سنة",
   "def": {
    "en": "A practice of the Prophet ﷺ that is rewarded when done and not sinful when left; its omission does not invalidate the act.",
    "tr": "Peygamber'in ﷺ uygulaması; yapana sevap vardır, terki günah değildir ve ibadeti geçersiz kılmaz.",
    "ar": "ما واظب عليه النبي ﷺ، يُثاب فاعله ولا يأثم تاركه، ولا يبطل العمل بتركه."
   }
  },
  {
   "id": "shart",
   "latin": "sharṭ",
   "ar": "شرط",
   "def": {
    "en": "A condition outside the act on which its validity depends, such as purity for prayer. A ruling of the declaratory kind (waḍʿī), not a duty (taklīfī).",
    "tr": "İbadetin dışında olup sıhhati ona bağlı olan şart; namaz için taharet gibi. Teklîfî değil vaz'î bir hükümdür.",
    "ar": "ما يتوقف عليه وجود الحكم وليس جزءًا من ماهيته، كالطهارة للصلاة. وهو من الحكم الوضعي لا التكليفي."
   }
  },
  {
   "id": "rukn",
   "latin": "rukn",
   "ar": "ركن",
   "def": {
    "en": "An integral part of the act itself; without it the act does not exist.",
    "tr": "İbadetin kendi içindeki asli parçası; o olmadan ibadet var olmaz.",
    "ar": "جزء الماهية الذي لا يقوم الشيء إلا به."
   }
  },
  {
   "id": "niyya",
   "latin": "niyya",
   "ar": "نية",
   "def": {
    "en": "The intention: the heart's resolve to do an act for God.",
    "tr": "Niyet: bir fiili Allah için yapmaya kalbin yönelmesi.",
    "ar": "قصد القلب فعلَ العبادة تقربًا إلى الله."
   }
  },
  {
   "id": "tartib",
   "latin": "tartīb",
   "ar": "ترتيب",
   "def": {
    "en": "Order: washing the limbs in the sequence of the verse.",
    "tr": "Tertip: uzuvları ayetteki sıraya göre yıkamak.",
    "ar": "غسل الأعضاء على الترتيب الوارد في الآية."
   }
  },
  {
   "id": "muwalat",
   "latin": "muwālāt",
   "ar": "موالاة",
   "def": {
    "en": "Continuity: washing each limb before the previous one dries. The Malikis call it fawr.",
    "tr": "Muvâlât: bir uzuv kurumadan diğerini yıkamak. Mâlikîler buna fevr der.",
    "ar": "ألا يؤخر غسل عضو حتى يجف الذي قبله، ويسميه المالكية الفور."
   }
  },
  {
   "id": "dalk",
   "latin": "dalk",
   "ar": "دلك",
   "def": {
    "en": "Rubbing: passing the hand over the limb with the water.",
    "tr": "Delk: suyla birlikte elle uzvu ovmak.",
    "ar": "إمرار اليد على العضو مع الماء."
   }
  },
  {
   "id": "mutamad",
   "latin": "muʿtamad",
   "ar": "المعتمد",
   "def": {
    "en": "The relied-upon position of a school, the one its later authorities give fatwa by. Each school names it in its own way: al-muftā bihi, al-mashhūr, al-aṣaḥḥ, al-madhhab.",
    "tr": "Mezhebin itimat edilen, sonraki otoritelerinin fetva verdiği görüşü. Her mezhep kendi adıyla anar: müftâ bih, meşhur, esah, mezheb.",
    "ar": "القول الذي عليه الفتوى في المذهب، ولكل مذهب اصطلاحه: المفتى به، المشهور، الأصح، المذهب."
   }
  },
  {
   "id": "ijma",
   "latin": "ijmāʿ",
   "ar": "إجماع",
   "def": {
    "en": "The agreement of the mujtahids of an age on a ruling. The agreement of the four schools is not by itself ijmāʿ; fiqhboard shows ijmāʿ only where a source claims it.",
    "tr": "Bir asrın müçtehitlerinin bir hükümde birleşmesi. Dört mezhebin aynı görüşte olması tek başına icmâ değildir; fiqhboard icmâyı yalnızca bir kaynak iddia ediyorsa gösterir.",
    "ar": "اتفاق مجتهدي عصرٍ على حكم شرعي. واتفاق المذاهب الأربعة ليس إجماعًا بذاته، ولا يُذكر الإجماع إلا منسوبًا إلى من حكاه."
   }
  },
  {
   "id": "naqid",
   "latin": "nāqiḍ (pl. nawāqiḍ)",
   "ar": "ناقض (نواقض)",
   "def": {
    "en": "A nullifier: what ends a state of wudu.",
    "tr": "Nâkız: abdesti bozan şey.",
    "ar": "ما يُبطل الوضوء ويرفع حكمه."
   }
  }
 ],
